{
  "name": "clearance",
  "version": "0.1.0",
  "private": true,
  "description": "Scan a local directory for secrets and report whether it is cleared to share.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "clearance": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:executable": "bun run scripts/build-executable.ts",
    "check:executable": "bun run build:executable && bun run scripts/check-executable.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run check:executable",
    "dev": "tsx src/cli.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/agents": "0.16.1",
    "picomatch": "4.0.3",
    "smol-toml": "1.4.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/picomatch": "4.0.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
